<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> • Sports Club</title>
  <link rel="stylesheet" href="/css/style.css"><script src="/js/app.js" defer></script>
</head>
<body>
<aside class="sidebar">
  <a href="/" class="brand"><span class="brand-icon">SC</span><span>Sports Club<small>Facility & Booking</small></span></a>
  <nav aria-label="เมนูหลัก">
    <a class="<%= path==='/'?'selected':'' %>" href="/">ภาพรวม</a>
