      <a class="<%= path.startsWith('/'+key)?'selected':'' %>" href="/<%= key %>"><%= label %></a>
    <% } %>
    <a class="<%= path==='/reports'?'selected':'' %>" href="/reports">รายงานรายสัปดาห์</a>
  </nav>
  <p class="sidebar-note">Database Systems<br>SQL Server • 9 ตาราง</p>
</aside>
<main>
  <header class="topbar"><span>SPORTS CLUB & FACILITY BOOKING</span><a class="button small" href="/court_bookings/new">+ สร้างการจอง</a></header>
  <section class="content"><h1><%= title %></h1>
